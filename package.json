{
  "name": "mcp-spotify-curator",
  "version": "1.1.0",
  "description": "Servidor MCP (Model Context Protocol) para gerenciamento e curadoria de playlists no Spotify",
  "main": "dist/index.js",
  "bin": {
    "mcp-spotify-curator": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "auth:setup": "tsx src/auth-setup.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "spotify",
    "playlists",
    "curator"
  ],
  "author": "",
  "license": "GPL-3.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
